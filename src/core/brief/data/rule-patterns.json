{
  "patterns": {
    "dash": { "register": "V01", "patterns": [{ "re": "[—–]" }] },
    "generic-action": {
      "register": "V03",
      "patterns": [
        { "re": "\\bmonitor(ing)? (the )?(regulatory |upcoming |ongoing )?developments\\b", "flags": "i" },
        { "re": "\\bcomply with the (regulation|directive)\\b", "flags": "i" },
        { "re": "\\bbe aware of\\b", "flags": "i" },
        { "re": "\\bconsider the implications\\b", "flags": "i" },
        { "re": "\\bstay (informed|up[- ]to[- ]date)\\b", "flags": "i" },
        { "re": "\\bkeep an eye on\\b", "flags": "i" }
      ]
    },
    "tier": {
      "register": "V09",
      "patterns": [
        { "re": "\\bT[1-7]\\b" },
        { "re": "\\bsource[ -]tier\\b", "flags": "i" },
        { "re": "\\btier[ -]?[1-7]\\b[^.\\n|]{0,30}\\b(source|sources|regulator\\w*|intergovernmental|primary|authority|evidence)\\b", "flags": "i" },
        { "re": "\\b(source|sources)[ -]\\(?tier[ -]?[1-7]\\b", "flags": "i" }
      ]
    },
    "score-schema": {
      "register": "V10",
      "patterns": [
        { "re": "(urgency|relevance|impact|priority|severity|credibility)[ _](score|rating)|sector_relevance|intersection_strength", "flags": "i" },
        { "re": "(penalty_range|cost_mechanism|enforcement_body|intelligence_items|section_claim_provenance|tier_estimate)", "flags": "i" }
      ]
    },
    "as-of": {
      "register": "V17",
      "patterns": [{ "re": "\\bas of\\b(?![^.\\n]{0,30}(\\d{4}|january|february|march|april|may|june|july|august|september|october|november|december|\ufffc))", "flags": "i" }]
    },
    "narration": {
      "register": "V13",
      "patterns": [{ "re": "(convention notes?|source pool|captured pool|integrity rule|forward-intelligence rule|fact citations?|fetched source content|\\bper the [a-z -]{3,40} rule\\b)", "flags": "i" }]
    },
    "pool-slot": {
      "register": "V13b",
      "patterns": [
        { "re": "\\b(character|captured|stored|source|item.s|fetched|input) pool\\b|\\bfive-claim floor\\b", "flags": "i" },
        { "re": "(^|\\n)\\s*(-\\s+)?\\[[a-z][a-z0-9]*_[a-z0-9_]+\\]" },
        { "re": "\\b[a-z]+_[a-z_]+ slot\\b|\\*\\*[a-z_]+ slot:?\\*\\*" }
      ]
    },
    "entity": { "register": "V15", "patterns": [{ "re": "&(amp|quot|lt|gt|nbsp|#\\d+);" }] },
    "ibid": { "register": "V16", "patterns": [{ "re": "\\bibid\\b", "flags": "i" }] },
    "double-hyphen": { "register": "V32", "patterns": [{ "re": "\\s--\\s" }] },
    "section-sign": { "register": "V32", "patterns": [{ "re": "§" }] },
    "structural": {
      "register": "V35",
      "patterns": [{ "re": "(^|\\n)\\s*\\|[^\\n]*\\|[ \\t]*\\|" }, { "re": "\\[([a-z0-9_]+)\\]\\s*\\[\\1\\]" }]
    },
    "claim-ledger": {
      "register": "V18",
      "patterns": [{ "re": "(\"claim_kind\"|\"claim_text\"|\"source_span\"|\"slot_key\")\\s*:|CLAIM_PROVENANCE_LEDGER|<<<|_PROVENANCE" }]
    },
    "url": { "register": "V14", "patterns": [{ "re": "https?://" }] },
    "sources-section": { "register": "V14", "patterns": [{ "re": "\\n#{1,3}[^\\n]*Sources[^\\n]*\\n[\\s\\S]*$" }] },
    "source-line": { "register": "V14", "patterns": [{ "re": "\\*?Source[^:\\n]{0,40}:" }] }
  },
  "limits": {
    "what_it_changes": { "register": "V28", "min": 80, "max": 200 },
    "banner": { "register": "V07", "window": 600 }
  }
}
