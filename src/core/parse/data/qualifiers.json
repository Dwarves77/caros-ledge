        "\\bAR5\\b",
        "fifth assessment report"
      ],
      "AR6": [
        "\\bAR6\\b",
        "sixth assessment report"
      ]
    },
    "distanceBasis": {
      "SFD": [
        "\\bSFD\\b",
        "shortest feasible distance"
      ],
      "GCD": [
        "\\bGCD\\b",
        "great[- ]circle"
      ],
      "actual": [
        "actual distance"
      ]
    },
    "massBasis": {
      "actual": [
        "actual (?:consignment )?(?:mass|weight)"
      ],
      "chargeable": [
        "chargeable (?:mass|weight)"
      ],
      "dimensional": [
        "dimensional (?:mass|weight)"
      ]
    },
    "scope3Category": {
      "4": [
        "category 4\\b",
        "\\bcat\\.? 4\\b"
      ],
      "9": [
        "category 9\\b",
        "\\bcat\\.? 9\\b"
      ]
    },
    "method": {
      "fuel": [
        "fuel[- ]based"
      ],
      "distance": [
        "distance[- ]based"
      ],
      "spend": [
        "spend[- ]based"
      ],
      "supplier": [
        "supplier[- ]specific"
      ]
    },
    "hubKind": {
      "TOC": [
        "\\bTOC\\b",
        "transport operation category"
      ],
      "HOC": [
        "\\bHOC\\b",
        "hub operation category"
      ]
    }
  },
  "screeningGrade": [
    "spend"
  ],
  "frameworks": [
    {
      "id": "GLEC",
      "pattern": "\\bGLEC(?: Framework)?,? (?:v|version )?(?<version>\\d+(?:\\.\\d+)*)"
    },
    {
      "id": "ISO 14083",
      "pattern": "\\bISO 14083(?::(?<version>\\d{4}))?"
    },
    {
      "id": "GHG Protocol",
      "pattern": "\\bGHG Protocol\\b(?:[^.]{0,40}?(?:v|version )(?<version>\\d+(?:\\.\\d+)*))?"
    }
