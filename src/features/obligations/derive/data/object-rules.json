{
  "phrases": [
    {
      "class": "ism_company",
      "pattern": "\\bshipping compan(?:y|ies)\\b|\\bshipowners?\\b"
    },
    {
      "class": "carrier",
      "pattern": "\\bcarriers?\\b|\\btransport operators?\\b|\\boperators?\\b"
    },
    {
      "class": "shipper",
      "pattern": "\\bshippers?\\b|\\bconsignors?\\b"
    },
    {
      "class": "forwarder",
      "pattern": "\\b(?:freight )?forwarders?\\b"
    },
    {
      "class": "nvocc",
      "pattern": "\\bNVOCCs?\\b|non-vessel[- ]operating common carriers?"
    },
    {
      "class": "aircraft_operator",
      "pattern": "\\baircraft operators?\\b"
    },
    {
      "class": "fuel_supplier",
      "pattern": "\\bfuel suppliers?\\b"
    },
    {
      "class": "producer",
      "pattern": "\\bproducers?\\b|\\bmanufacturers?\\b"
    },
    {
      "class": "importer_of_record",
      "pattern": "\\bimporters?\\b"
    },
    {
      "class": "exporter",
      "pattern": "\\bexporters?\\b"
    },
    {
      "class": "packaging_user",
      "pattern": "\\busers? of (?:transport|grouped) packaging\\b"
    },
    {
      "class": "trader",
      "pattern": "\\btraders?\\b"
    },
    {
      "class": "member_state",
      "pattern": "\\bMember States?\\b"
    },
    {
      "class": "distributor",
      "pattern": "\\bdistributors?\\b"
    },
    {
      "class": "packer_filler",
      "pattern": "\\b(?:packers?|fillers?)\\b"
    },
    {
      "class": "rating_provider",
      "pattern": "\\b(?:ESG )?rating providers?\\b"
    },
    {
      "class": "undertaking",
      "pattern": "\\bundertakings?\\b"
    }
  ],
  "pinpoint": "\\b(?:Article|Art\\.)\\s+\\d+[a-z]?(?:\\(\\d+\\))?(?:\\([a-z]\\))?",
  "deontic": "\\b(?:shall|must|is required to|are required to)\\b",
  "crossReference": "^[^.;\\n]{0,48}?\\b(?:of|to|in|under)\\s+(?:the\\s+)?(?:Directive|Regulation|Decision|Treaty|Council|Commission|Convention|Annex)",
  "window": {
    "maxSentence": 400,
    "pinpointLookBack": 200,
    "headingOverlap": 16,
    "subjectDistance": 80
  },
  "triggerAttribute": "instrument_in_scope",
  "datePhrases": {
    "date_of_application": "\\bappl(?:y|ies|ication)\\b",
    "enforcement_start": "\\b(?:enforce(?:ment|d)?|penalt(?:y|ies))\\b"
  },
  "thresholds": {
    "percent": "\\b(\\d+(?:\\.\\d+)?)\\s*(?:%|percent)\\b",
    "emptySpace": "\\b(?:max(?:imum)?\\s+)?(?:empty|void)\\s+space(?:\\s+ratio)?(?:\\s+of)?(?:\\s+max(?:imum)?)?\\s*(?:not\\s+exceed(?:ing)?\\s*)?(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\b",
    "recycledContent": "\\b(?:at\\s+least\\s+)?(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\s+(?:post-consumer\\s+)?recycled\\s+(?:plastic\\s+)?content\\b|\\b(?:post-consumer\\s+)?recycled\\s+(?:plastic\\s+)?content(?:\\s+of)?(?:\\s+at\\s+least)?\\s*(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\b",
    "deMinimisWeight": "\\b(?:less\\s+than|<)\\s*(\\d+(?:\\.\\d+)?\\s*(?:%|percent))(?:\\s+(?:of|by)\\s+weight)?\\b|\\bde\\s+minimis\\b",
    "tonnageCutoff": "\\b(\\d+(?:[.,]\\d+)?)\\s*(?:tonnes?|tons?|gross\\s+tonnage|GT)\\b"
  },
  "exemptions": {
    "b2bTransport": "\\b(?:exempt(?:ed|ion)?|derogat(?:ion|e)|except(?:ed)?)\\s+(?:for|from|with\\s+respect\\s+to\\s+)?(?:B2B\\s+(?:transport\\s+)?packaging|transport\\s+packaging|reusable\\s+transport\\s+packaging)\\b",
    "criticalFactors": "\\b(?:custom-made|product[-\\s]protection|critical\\s+performance\\s+factors?|essential\\s+requirements?|dangerous\\s+goods)\\b",
    "closedLoop": "\\b(?:reusable\\s+closed-loop\\s+systems?|closed[-\\s]loop\\s+systems?|system\\s+for\\s+reuse)\\b"
  },
  "complianceArtifacts": {
    "declarationOfConformity": "\\b(?:EU\\s+)?declaration\\s+of\\s+conformity(?:\\s*(?:\\(|in\\s+accordance\\s+with\\s+)?(?:Annex\\s+VIII|annex\\s+8)\\)?)?\\b",
    "conformityAssessment": "\\b(?:conformity\\s+assessment|technical\\s+documentation)(?:\\s*(?:\\(|in\\s+accordance\\s+with\\s+)?(?:Annex\\s+VII|annex\\s+7)\\)?)?\\b",
    "producerRegister": "\\b(?:national\\s+)?producer\\s+register(?:\\s+established|\\s+enrollment|\\s+registration|\\s+registered\\s+with\\s+the\\s+register)?\\b|\\bregister\\s+of\\s+producers\\b"
  },
  "labelingMarking": {
    "sorting": "\\b(?:material\\s+composition(?:\\s+sorting)?(?:\\s+marking|\\s+labels?)?|sorting\\s+labels?|harmonised\\s+label(?:ling)?)\\b",
    "reusableSystem": "\\b(?:reusable\\s+(?:packaging\\s+)?labels?|circular\\s+system\\s+labels?|reusability\\s+label)\\b",
    "qrDataCarrier": "\\b(?:QR\\s+code|digital\\s+data\\s+carrier|data\\s+carrier|RFID)\\b"
  }
}
