{
  "phrases": [
    {
      "class": "ism_company",
      "pattern": "\\bshipping compan(?:y|ies)\\b|\\bshipowners?\\b"
    },
    {
      "class": "carrier",
      "pattern": "\\bcarriers?\\b|\\btransport operators?\\b|\\boperators?\\b"
    },
    {
      "class": "shipper",
      "pattern": "\\bshippers?\\b|\\bconsignors?\\b"
    },
    {
      "class": "forwarder",
      "pattern": "\\b(?:freight )?forwarders?\\b"
    },
    {
      "class": "nvocc",
      "pattern": "\\bNVOCCs?\\b|non-vessel[- ]operating common carriers?"
    },
    {
      "class": "aircraft_operator",
      "pattern": "\\baircraft operators?\\b"
    },
    {
      "class": "fuel_supplier",
      "pattern": "\\bfuel suppliers?\\b"
    },
    {
      "class": "producer",
      "pattern": "\\bproducers?\\b|\\bmanufacturers?\\b"
    },
    {
      "class": "importer_of_record",
      "pattern": "\\bimporters?\\b"
    },
    {
      "class": "exporter",
      "pattern": "\\bexporters?\\b"
    },
    {
      "class": "packaging_user",
      "pattern": "\\busers? of (?:transport|grouped) packaging\\b"
    },
    {
      "class": "trader",
      "pattern": "\\btraders?\\b"
    },
    {
      "class": "member_state",
      "pattern": "\\bMember States?\\b"
    },
    {
      "class": "distributor",
      "pattern": "\\bdistributors?\\b"
    },
    {
      "class": "packer_filler",
      "pattern": "\\b(?:packers?|fillers?)\\b"
    },
    {
      "class": "rating_provider",
      "pattern": "\\b(?:ESG )?rating providers?\\b"
    },
    {
      "class": "undertaking",
      "pattern": "\\bundertakings?\\b"
    }
  ],
  "pinpoint": "\\b(?:Article|Art\\.)\\s+\\d+[a-z]?(?:\\(\\d+\\))?(?:\\([a-z]\\))?",
  "deontic": "\\b(?:shall|must|is required to|are required to)\\b",
  "crossReference": "^[^.;\\n]{0,48}?\\b(?:of|to|in|under)\\s+(?:the\\s+)?(?:Directive|Regulation|Decision|Treaty|Council|Commission|Convention|Annex)",
  "window": {
    "maxSentence": 400,
    "pinpointLookBack": 200,
    "headingOverlap": 16,
    "subjectDistance": 80
  },
  "triggerAttribute": "instrument_in_scope",
  "datePhrases": {
    "date_of_application": "\\bappl(?:y|ies|ication)\\b",
    "enforcement_start": "\\b(?:enforce(?:ment|d)?|penalt(?:y|ies))\\b"
  },
  "triggerClassifiers": [
    {
      "attribute": "void_space_ratio",
      "comparison": "<=",
      "pattern": "\\b(?:max(?:imum)?\\s+)?(?:empty|void)\\s+space(?:\\s+ratio)?(?:\\s+of)?(?:\\s+max(?:imum)?)?\\s*(?:not\\s+exceed(?:ing)?\\s*)?(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\b"
    },
    {
      "attribute": "recycled_content",
      "comparison": ">=",
      "pattern": "\\b(?:at\\s+least\\s+)?(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\s+(?:post-consumer\\s+)?recycled\\s+(?:plastic\\s+)?content\\b|\\b(?:post-consumer\\s+)?recycled\\s+(?:plastic\\s+)?content(?:\\s+of)?(?:\\s+at\\s+least)?\\s*(\\d+(?:\\.\\d+)?\\s*(?:%|percent))\\b"
    },
    {
      "attribute": "de_minimis_weight",
      "comparison": "<",
      "pattern": "\\b(?:less\\s+than|<)\\s*(\\d+(?:\\.\\d+)?\\s*(?:%|percent))(?:\\s+(?:of|by)\\s+weight)?\\b|\\bde\\s+minimis\\b"
    },
    {
      "attribute": "tonnage_cutoff",
      "comparison": ">=",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?\\s*(?:tonnes?|tons?|gross\\s+tonnage|GT))\\b"
    },
    {
      "attribute": "exemption_scope",
      "token": "b2b_transport_packaging",
      "pattern": "\\b(?:exempt(?:ed|ion)?|derogat(?:ion|e)|except(?:ed)?)\\s+(?:for|from|with\\s+respect\\s+to\\s+)?(?:B2B\\s+(?:transport\\s+)?packaging|transport\\s+packaging|reusable\\s+transport\\s+packaging)\\b"
    },
    {
      "attribute": "exemption_scope",
      "token": "reusable_closed_loop",
      "pattern": "\\b(?:reusable\\s+closed-loop\\s+systems?|closed[-\\s]loop\\s+systems?|system\\s+for\\s+reuse)\\b"
    },
    {
      "attribute": "exemption_scope",
      "token": "critical_performance_factors",
      "pattern": "\\b(?:custom-made|product[-\\s]protection|critical\\s+performance\\s+factors?|essential\\s+requirements?|dangerous\\s+goods)\\b"
    },
    {
      "attribute": "labeling_marking_class",
      "token": "material_composition_sorting",
      "pattern": "\\b(?:material\\s+composition(?:\\s+sorting)?(?:\\s+marking|\\s+labels?)?|sorting\\s+labels?|harmonised\\s+label(?:ling)?)\\b"
    },
    {
      "attribute": "labeling_marking_class",
      "token": "reusable_qr_data_carrier",
      "pattern": "\\b(?:reusable\\s+(?:packaging\\s+)?labels?|circular\\s+system\\s+labels?|reusability\\s+label)\\b|\\b(?:QR\\s+code|digital\\s+data\\s+carrier|data\\s+carrier|RFID)\\b"
    }
  ],
  "artifactClasses": [
    {
      "class": "declaration_of_conformity",
      "pattern": "\\b(?:EU\\s+)?declaration\\s+of\\s+conformity(?:\\s*(?:\\(|in\\s+accordance\\s+with\\s+)?(?:Annex\\s+VIII|annex\\s+8)\\)?)?\\b"
    },
    {
      "class": "conformity_assessment_technical_documentation",
      "pattern": "\\b(?:conformity\\s+assessment|technical\\s+documentation)(?:\\s*(?:\\(|in\\s+accordance\\s+with\\s+)?(?:Annex\\s+VII|annex\\s+7)\\)?)?\\b"
    },
    {
      "class": "producer_register",
      "pattern": "\\b(?:national\\s+)?producer\\s+register(?:\\s+established|\\s+enrollment|\\s+registration|\\s+registered\\s+with\\s+the\\s+register)?\\b|\\bregister\\s+of\\s+producers\\b"
    }
  ],
  "absence": "M",
  "modeClassifiers": [
    {
      "id": "air-span",
      "on": "span",
      "pattern": "\\b(?:aircraft operators?|aviation|air carriers?|air cargo|airports?|aircraft)\\b",
      "modes": [
        "air"
      ]
    },
    {
      "id": "ocean-span",
      "on": "span",
      "pattern": "\\b(?:ships?|shipping compan(?:y|ies)|shipowners?|ports? of call|maritime|seagoing|sea-going|ocean)\\b",
      "modes": [
        "ocean"
      ]
    },
    {
      "id": "road-span",
      "on": "span",
      "pattern": "\\b(?:heavy[- ]duty vehicles?|road (?:haulage|transport|freight|vehicles?)|lorr(?:y|ies)|trucks?|HGVs?|motor vehicles?)\\b",
      "modes": [
        "road"
      ]
    },
    {
      "id": "rail-span",
      "on": "span",
      "pattern": "\\b(?:rail(?:way)?s?(?: freight| transport| undertakings?)?|freight trains?|locomotives?)\\b",
      "modes": [
        "rail"
      ]
    },
    {
      "id": "inland-waterway-span",
      "on": "span",
      "pattern": "\\b(?:inland (?:waterways?|navigation|shipping)|barges?)\\b",
      "modes": [
        "inland_waterway"
      ]
    },
    {
      "id": "consignment-span",
      "on": "span",
      "pattern": "\\b(?:packaging|customs|carbon border adjustment|CBAM|ISO 14083|consignments?)\\b",
      "modes": [
        "road",
        "rail",
        "ocean",
        "inland_waterway",
        "air"
      ],
      "consignment_wide": true
    },
    {
      "id": "air-instrument",
      "on": "instrument",
      "pattern": "\\b(?:aviation|aircraft|air transport|CORSIA|ReFuelEU)\\b",
      "modes": [
        "air"
      ]
    },
    {
      "id": "ocean-instrument",
      "on": "instrument",
      "pattern": "\\b(?:maritime|shipping|ships?|port state)\\b",
      "modes": [
        "ocean"
      ]
    },
    {
      "id": "road-instrument",
      "on": "instrument",
      "pattern": "\\b(?:heavy[- ]duty vehicles?|road vehicles?|road transport|motor vehicles?)\\b",
      "modes": [
        "road"
      ]
    },
    {
      "id": "rail-instrument",
      "on": "instrument",
      "pattern": "\\b(?:railways?|rail transport|rail freight)\\b",
      "modes": [
        "rail"
      ]
    },
    {
      "id": "inland-waterway-instrument",
      "on": "instrument",
      "pattern": "\\binland (?:waterways?|navigation)\\b",
      "modes": [
        "inland_waterway"
      ]
    },
    {
      "id": "consignment-instrument",
      "on": "instrument",
      "pattern": "\\b(?:packaging|customs|carbon border adjustment|CBAM|ISO 14083)\\b",
      "modes": [
        "road",
        "rail",
        "ocean",
        "inland_waterway",
        "air"
      ],
      "consignment_wide": true
    }
  ],
  "statutoryMaximum": [
    {
      "id": "fine-up-to",
      "kind": "maximum",
      "pattern": "\\b(?:fines?|penalt(?:y|ies)|pecuniary sanctions?)\\b\\s+(?:of\\s+)?(?:up to|not exceeding|not more than|no more than|at least|not less than)\\s+(?:(?:(?:EUR|\u20ac|USD|US\\$|\\$|GBP|\u00a3)\\s?\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?(?:\\s?(?:million|thousand|billion))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:EUR|euros?|USD|GBP))(?:\\s+(?:per|for each|for every)\\s+(?:(?:metric\\s+)?(?:tonnes?|tons?)(?:\\s+of\\s+(?:CO2|carbon dioxide)(?:\\s+equivalent)?)?|tCO2e?|excess emissions?|FEU|TEU|GJ|gigajoule|container|consignment|shipment|kilogram|kg))?|\\d{1,3}(?:[.,]\\d+)?\\s?(?:%|per\\s?cent|percent)\\s+of\\s+(?:the\\s+)?(?:[a-z-]+\\s+){0,3}turnover)"
    },
    {
      "id": "excess-emissions-penalty",
      "kind": "maximum",
      "pattern": "\\bexcess emissions? penalty\\b[^.;\\d\u20ac$\u00a3]{0,40}(?:(?:EUR|\u20ac|USD|US\\$|\\$|GBP|\u00a3)\\s?\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?(?:\\s?(?:million|thousand|billion))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:EUR|euros?|USD|GBP))(?:\\s+(?:per|for each|for every)\\s+(?:(?:metric\\s+)?(?:tonnes?|tons?)(?:\\s+of\\s+(?:CO2|carbon dioxide)(?:\\s+equivalent)?)?|tCO2e?|excess emissions?|FEU|TEU|GJ|gigajoule|container|consignment|shipment|kilogram|kg))?"
    },
    {
      "id": "penalty-of-amount",
      "kind": "maximum",
      "pattern": "\\b(?:fines?|penalt(?:y|ies)|pecuniary sanctions?)\\b\\s+(?:of|shall be)\\s+(?:(?:EUR|\u20ac|USD|US\\$|\\$|GBP|\u00a3)\\s?\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?(?:\\s?(?:million|thousand|billion))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:EUR|euros?|USD|GBP))(?:\\s+(?:per|for each|for every)\\s+(?:(?:metric\\s+)?(?:tonnes?|tons?)(?:\\s+of\\s+(?:CO2|carbon dioxide)(?:\\s+equivalent)?)?|tCO2e?|excess emissions?|FEU|TEU|GJ|gigajoule|container|consignment|shipment|kilogram|kg))?"
    },
    {
      "id": "turnover-share",
      "kind": "maximum",
      "pattern": "\\b(?:fines?|penalt(?:y|ies)|pecuniary sanctions?)\\b[^.;\\d\u20ac$\u00a3]{0,60}\\d{1,3}(?:[.,]\\d+)?\\s?(?:%|per\\s?cent|percent)\\s+of\\s+(?:the\\s+)?(?:[a-z-]+\\s+){0,3}turnover"
    },
    {
      "id": "shall-not-exceed",
      "kind": "maximum",
      "pattern": "\\b(?:fines?|penalt(?:y|ies)|pecuniary sanctions?)\\b[^.;]{0,80}\\b(?:shall|may|must) not exceed\\s+(?:(?:(?:EUR|\u20ac|USD|US\\$|\\$|GBP|\u00a3)\\s?\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?(?:\\s?(?:million|thousand|billion))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:EUR|euros?|USD|GBP))(?:\\s+(?:per|for each|for every)\\s+(?:(?:metric\\s+)?(?:tonnes?|tons?)(?:\\s+of\\s+(?:CO2|carbon dioxide)(?:\\s+equivalent)?)?|tCO2e?|excess emissions?|FEU|TEU|GJ|gigajoule|container|consignment|shipment|kilogram|kg))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:%|per\\s?cent|percent|tonnes?|MW|months?|g\\s?CO2e?\\s?/\\s?MJ))"
    },
    {
      "id": "maximum-cap",
      "kind": "maximum",
      "pattern": "\\b(?:maximum|cap|ceiling)\\s+(?:amount\\s+of\\s+)?(?:fines?|penalt(?:y|ies))\\s+(?:of|at)\\s+(?:(?:(?:EUR|\u20ac|USD|US\\$|\\$|GBP|\u00a3)\\s?\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?(?:\\s?(?:million|thousand|billion))?|\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?\\s?(?:EUR|euros?|USD|GBP))(?:\\s+(?:per|for each|for every)\\s+(?:(?:metric\\s+)?(?:tonnes?|tons?)(?:\\s+of\\s+(?:CO2|carbon dioxide)(?:\\s+equivalent)?)?|tCO2e?|excess emissions?|FEU|TEU|GJ|gigajoule|container|consignment|shipment|kilogram|kg))?|\\d{1,3}(?:[.,]\\d+)?\\s?(?:%|per\\s?cent|percent)\\s+of\\s+(?:the\\s+)?(?:[a-z-]+\\s+){0,3}turnover)"
    },
    {
      "id": "penalty-formula",
      "kind": "formula",
      "pattern": "\\b(?:fines?|penalt(?:y|ies)|pecuniary sanctions?)\\b[^.;]{0,80}\\b(?:calculated as|multiplied by|equal to the product of|computed as)\\b[^.;]{0,160}"
    }
  ],
  "fill": {
    "batch": 500
  }
}
