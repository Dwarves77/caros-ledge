    },
    {
      "class": "shipper",
      "pattern": "\\bshippers?\\b|\\bconsignors?\\b"
    },
    {
      "class": "forwarder",
      "pattern": "\\b(?:freight )?forwarders?\\b"
    },
    {
      "class": "nvocc",
      "pattern": "\\bNVOCCs?\\b|non-vessel[- ]operating common carriers?"
    },
    {
      "class": "aircraft_operator",
      "pattern": "\\baircraft operators?\\b"
    },
    {
      "class": "fuel_supplier",
      "pattern": "\\bfuel suppliers?\\b"
    },
    {
      "class": "producer",
      "pattern": "\\bproducers?\\b|\\bmanufacturers?\\b"
    },
    {
      "class": "importer_of_record",
      "pattern": "\\bimporters?\\b"
    },
    {
      "class": "exporter",
      "pattern": "\\bexporters?\\b"
    },
    {
      "class": "packaging_user",
      "pattern": "\\busers? of (?:transport|grouped) packaging\\b"
    },
    {
      "class": "trader",
      "pattern": "\\btraders?\\b"
    },
    {
      "class": "member_state",
      "pattern": "\\bMember States?\\b"
    },
    {
      "class": "distributor",
      "pattern": "\\bdistributors?\\b"
    },
    {
      "class": "packer_filler",
      "pattern": "\\b(?:packers?|fillers?)\\b"
    },
    {
      "class": "rating_provider",
      "pattern": "\\b(?:ESG )?rating providers?\\b"
    },
    {
      "class": "undertaking",
      "pattern": "\\bundertakings?\\b"
    }
