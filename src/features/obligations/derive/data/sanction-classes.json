{
  "_note": "DERIVE-3 data: what makes a span a penalty provision (trigger), what is excluded (exclusions), and the sanction classes with their labels (noun phrases the readers render). Patterns are case-insensitive regular expressions; every class pattern is matched against the span itself and the matched text is recorded as the class's basis. structure is the grammar of a statute's headings, numbered paragraphs and lettered annex parts.",
  "trigger": {
    "figureWindow": 120,
    "words": "\\b(?:penalt(?:y|ies)|fines?|fined|sanctions?|liable to|shall pay|infringements?|non-?compliance)\\b",
    "figure": [
      "(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?\\d",
      "\\d\\s?(?:EUR|euros?|%|per\\s?cent|percent)\\b",
      "\\b(?:per|for each|for every)\\s+(?:(?:equivalent\\s+)?(?:metric\\s+)?(?:tonnes?|tons?)|tCO2e?|kg|container|FEU|TEU|consignment|shipment|violation|offence|day|vehicle|ship)\\b"
    ],
    "liability": [
      "\\b(?:liable to|shall pay|shall be (?:held )?liable|held liable|is liable|are liable|shall be fined|shall be subject to)\\b",
      "\\bpays? by\\b[^.;]{0,160}\\bamount\\b"
    ],
    "memberState": [
      "\\bMember States\\b[^.]{0,120}?\\b(?:lay down|determine|provide for|shall have)\\b[^.]{0,260}?\\b(?:penalt|sanction)\\w*"
    ],
    "reference": [
      "\\bpenalt(?:y|ies)\\b[^.]{0,80}?\\b(?:set out|provided for|laid down|referred to)\\s+in\\s+(?:paragraph|Article|Annex)\\b[^.]{0,80}?\\bshall\\s+(?:also\\s+)?apply"
    ],
    "calculation": [
      "\\bpenalt(?:y|ies)\\b[^.]{0,120}?\\b(?:shall be calculated|calculated (?:as follows|in accordance))"
    ]
  },
  "exclusions": [
    {
      "id": "fines-material-noun",
      "pattern": "\\bfines?\\b(?=\\s+(?:with|from|content|fraction|particles?|material|dust|aggregate|powder)\\b)|\\b(?:coal|ore|dust|soil|sand|mineral|wood|ash|clay|metal|grain|aggregate|cement)\\s+fines\\b"
    },
    {
      "id": "fine-adjective",
      "pattern": "\\bfine\\s+(?:particulate|particles?|dust|powder|grain|mesh|print|tuning|sand|screening)\\b|\\bfine[-\\s](?:grained|tuned)\\b|\\b(?:very|so|too|how|extremely)\\s+fine\\b"
    },
    {
      "id": "penalty-notice-procedure",
      "pattern": "\\bpenalty\\s+notices?\\b[^.]{0,200}?\\b(?:electronic form|in writing|served|given)\\b"
    }
  ],
  "classes": [
    {
      "token": "monetary_per_unit",
      "label": "Monetary penalty per unit",
      "patterns": [
        "(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?(?:\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?|\\d+(?:[.,]\\d+)?)\\s+(?:per|for each|for every)\\s+\\w+(?:\\s+\\w+){0,4}",
        "\\b(?:EUR|USD|GBP)\\s+(?:per|for each)\\s+\\w+(?:\\s+\\w+){0,4}"
      ]
    },
    {
      "token": "monetary_capped",
      "label": "Monetary penalty with a maximum",
      "patterns": [
        "(?:up to|not exceeding|not more than|no more than|at most|shall not exceed|maximum (?:of|penalty|fine))\\s+(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?(?:\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?|\\d+(?:[.,]\\d+)?)(?:\\s*(?:million|billion|thousand))?",
        "\\d+\\s?(?:%|per\\s?cent|percent)\\s+of\\s+(?:the\\s+|its\\s+)?(?:[a-z-]+\\s+){0,3}(?:turnover|revenue)"
      ]
    },
    {
      "token": "monetary_formula",
      "label": "Monetary penalty by published formula",
      "patterns": [
        "\\bmultiplication of\\s+(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?[\\d.,\\s]*\\d\\s+by\\b[^.;]{0,200}",
        "\\bamount equal to\\b[^.;]{0,160}\\b(?:formulas?|multiplication)\\b[^.;]{0,100}",
        "\\bshall be calculated as follows\\b",
        "\\bshall be calculated in accordance with\\b[^.;]{0,100}"
      ]
    },
    {
      "token": "monetary_fixed",
      "label": "Fixed monetary penalty",
      "patterns": [
        "\\b(?:penalty|fine|charge)\\b[^.;]{0,80}?\\b(?:of|is|shall be|equal to)\\s+(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?(?:\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?|\\d+(?:[.,]\\d+)?)"
      ]
    },
    {
      "token": "administrative",
      "label": "Administrative measure",
      "patterns": [
        "\\bcorrective action plan\\b",
        "\\bmarket[- ]access (?:denial|ban|restriction)\\b",
        "\\bsuspension of\\b[^.;]{0,60}",
        "\\bdetention of\\b[^.;]{0,60}",
        "\\bwithdrawal of (?:the )?(?:approval|authori[sz]ation|licen[cs]e|certificate)\\b",
        "\\bremoval from the (?:register|market)\\b"
      ]
    },
    {
      "token": "criminal_or_standard_scale",
      "label": "Criminal offence or standard scale",
      "patterns": [
        "\\bstandard scale\\b",
        "\\bimprisonment\\b",
        "\\bsummary conviction\\b",
        "\\bon conviction\\b",
        "\\bguilty of an offence\\b",
        "\\bcriminal offence\\b"
      ]
    },
    {
      "token": "member_state_defined",
      "label": "Penalty rules set by Member States",
      "patterns": [
        "\\bMember States\\b[^.]{0,120}?\\b(?:lay down|determine|provide for|shall have)\\b[^.]{0,260}?\\b(?:penalt|sanction)\\w*",
        "\\brules on penalties\\b",
        "\\beffective, proportionate and dissuasive\\b"
      ]
    },
    {
      "token": "by_reference",
      "label": "Penalty set out in another provision",
      "patterns": [
        "\\bpenalt(?:y|ies)\\b[^.]{0,80}?\\b(?:set out|provided for|laid down|referred to)\\s+in\\s+(?:paragraph|Article|Annex)\\b[^.]{0,80}?\\bshall\\s+(?:also\\s+)?apply",
        "\\bamount equal to the [\\w ]{0,30}penalt(?:y|ies)\\b[^.;]{0,40}\\b(?:notified|laid down|set out|determined) pursuant to\\b"
      ]
    }
  ],
  "costFormula": [
    "\\b(?:\\w+\\s+){0,8}?multipl(?:ication of|ied by)\\b[^.;]*",
    "\\b(?:\\w+\\s+){0,8}?(?:for each|for every)\\s+(?:metric\\s+)?(?:tonnes?|tons?)\\b[^.;]*",
    "\\d[\\d\\s]*\\d\\s+\\d+\\.\\s+Is the amount to be paid in \\w+ per [^.;()]*"
  ],
  "figureFallback": [
    "\\d[\\d\\s]*\\d\\s+\\d+\\.\\s+Is the amount to be paid in \\w+ per [^.;()]*",
    "(?:EUR|€|USD|US\\$|\\$|GBP|£)\\s?(?:\\d{1,3}(?:[ .,]\\d{3})*(?:[.,]\\d+)?|\\d+(?:[.,]\\d+)?)(?:\\s+(?:per|for each|for every)\\s+\\w+(?:\\s+\\w+){0,4})?"
  ],
  "structure": {
    "headings": [
      {
        "kind": "article",
        "pattern": "(?:^|[.;:)\\]]\\s|▼\\w+\\s)(Article\\s+\\d+[a-z]{0,2})\\s+(?=[A-Z▼])",
        "paragraph": "(?:^|\\s)(\\d{1,2}[a-z]?)\\.\\s+(?=[A-Z(—])",
        "sequence": "number"
      },
      {
        "kind": "annex",
        "pattern": "\\b(ANNEX\\s+[IVX]+)\\s+(?=[A-Z])",
        "paragraph": "(?:^|\\s)([A-Z])\\.\\s+(?=[A-Z])",
        "sequence": "upper"
      },
      {
        "kind": "schedule",
        "pattern": "\\b(SCHEDULE\\s+\\d+)\\s+(?=[A-Z])",
        "paragraph": "(?:^|\\s)(\\d{1,2}[a-z]?)\\.\\s+(?=[A-Z(—])",
        "sequence": "number"
      },
      {
        "kind": "part",
        "pattern": "\\b(PART\\s+\\d+)\\s+(?=[A-Z])",
        "paragraph": "(?:^|\\s)(\\d{1,2}[a-z]?)\\.\\s+(?=[A-Z(—])",
        "sequence": "number"
      },
      {
        "kind": "section",
        "pattern": "(?:^|[.;:)\\]]\\s)(§\\s?\\d+(?:\\.\\d+)*)\\s+(?=[A-Z])",
        "paragraph": "(?:^|\\s)\\(([a-z])\\)\\s+(?=[A-Z])",
        "sequence": "lower"
      }
    ],
    "maxSpan": 1200
  },
  "enforcementStart": [
    "(?:shall|will)\\s+apply\\s+(?:as\\s+)?from\\s+",
    "\\bappl(?:y|ies)\\s+from\\s+",
    "\\bapplicable\\s+from\\s+",
    "\\bwith effect from\\s+",
    "\\benforceable\\s+from\\s+"
  ]
}
